{
  "name": "nimble-core",
  "version": "0.1.0",
  "description": "nimble-core API",
  "private": true,
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "knex migrate:latest && node index.js | bunyan",
    "worker": "knex migrate:latest && node worker.js | bunyan",
    "forever-api": "node_modules/forever/bin/forever start -l /tmp/forever.log -o /tmp/forever.log -e /tmp/forever.log --append --minUptime 2000 --spinSleepTime 10000 index.js",
    "forever-worker": "node_modules/forever/bin/forever start -l /tmp/forever.log -o /tmp/forever.log -e /tmp/forever.log --append --minUptime 2000 --spinSleepTime 10000 worker.js",
